---
import type { ImageMetadata } from 'astro';
import { SITE } from '@/lib/site';
import type { JsonLd } from '@/lib/site';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  image?: ImageMetadata | string;
  imageAlt?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: JsonLd;
}

const {
  title,
  description,
  ogType = 'website',
  image,
  imageAlt = SITE.ogImageAlt,
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const resolvedImage =
  typeof image === 'string'
    ? { url: new URL(image, Astro.site), width: undefined, height: undefined }
    : image
      ? {
          url: new URL(image.src, Astro.site),
          width: image.width,
          height: image.height,
        }
      : {
          url: new URL(SITE.ogImage, Astro.site),
          width: SITE.ogImageWidth,
          height: SITE.ogImageHeight,
        };
const isDefaultImage = !image;
const ogImage = resolvedImage.url;
---

<meta charset="utf-8" />
<meta
  name="viewport"
  content="width=device-width, initial-scale=1, viewport-fit=cover"
/>
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
<link rel="canonical" href={canonicalURL} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`Writing — ${SITE.brand}`}
  href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.siteName} />
<meta property="og:locale" content={SITE.ogLocale} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={imageAlt} />
{
  resolvedImage.width && (
    <meta property="og:image:width" content={String(resolvedImage.width)} />
  )
}
{
  resolvedImage.height && (
    <meta property="og:image:height" content={String(resolvedImage.height)} />
  )
}
{
  isDefaultImage && (
    <meta property="og:image:type" content="image/png" />
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

{
  ogType === 'article' && publishedTime && (
    <meta
      property="article:published_time"
      content={publishedTime.toISOString()}
    />
  )
}
{
  ogType === 'article' && modifiedTime && (
    <meta
      property="article:modified_time"
      content={modifiedTime.toISOString()}
    />
  )
}
{
  ogType === 'article' && (
    <meta property="article:author" content={SITE.author} />
  )
}

{
  jsonLd && (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  )
}
