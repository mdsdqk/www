---
// Included on every page via BaseLayout. Imports global.css so it lands everywhere.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE } from '@/lib/site';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  image?: ImageMetadata | string;
}

const { title, description, ogType = 'website', image } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// TODO(launch asset): add public/og-default.png (1200×630) — SPEC §6.
const ogImage = new URL(
  typeof image === 'string' ? image : (image?.src ?? '/og-default.png'),
  Astro.site,
);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`Writing — ${SITE.brand}`}
  href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />

{/* SPEC §3, §4 — inline theme bootstrap, no-flash, ≤500 bytes, runs before paint */}
<script is:inline>
  (function () {
    try {
      var s = localStorage.getItem('theme');
      var dark = s
        ? s === 'dark'
        : window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', dark);
    } catch (e) {}
  })();
</script>
