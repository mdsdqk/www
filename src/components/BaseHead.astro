---
// Included on every page via BaseLayout. Imports global.css so it lands everywhere.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import Seo from '@/components/Seo.astro';
import type { JsonLd } from '@/lib/site';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  image?: ImageMetadata | string;
  imageAlt?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: JsonLd;
}

const {
  title,
  description,
  ogType = 'website',
  image,
  imageAlt,
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props;
---

<Seo
  title={title}
  description={description}
  ogType={ogType}
  image={image}
  imageAlt={imageAlt}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  jsonLd={jsonLd}
/>

{/* SPEC §3, §4 — inline theme bootstrap, no-flash, ≤500 bytes, runs before paint */}
<script is:inline>
  (function () {
    try {
      var s = localStorage.getItem('theme');
      var dark = s
        ? s === 'dark'
        : window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', dark);
    } catch (e) {}
  })();
</script>
