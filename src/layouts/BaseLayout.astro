---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import VercelAnalytics from '@/islands/VercelAnalytics';
import {
  SITE,
  jsonLdGraph,
  personJsonLd,
  websiteJsonLd,
  type JsonLd,
} from '@/lib/site';
import type { ImageMetadata } from 'astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  image?: ImageMetadata | string;
  imageAlt?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLdExtra?: JsonLd[];
}

const {
  title,
  description = SITE.description,
  ogType = 'website',
  image,
  imageAlt,
  publishedTime,
  modifiedTime,
  jsonLdExtra = [],
} = Astro.props;

const fullTitle = title ? `${title} — ${SITE.brand}` : SITE.title;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <BaseHead
      title={fullTitle}
      description={description}
      ogType={ogType}
      image={image}
      imageAlt={imageAlt}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      jsonLd={jsonLdGraph([websiteJsonLd(), personJsonLd(), ...jsonLdExtra])}
    />
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4"
      >Skip to content</a
    >
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <VercelAnalytics client:load />
  </body>
</html>
