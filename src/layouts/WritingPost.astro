---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import { SITE } from '@/lib/site';

interface Props {
  entry: CollectionEntry<'writing'>;
}

const { entry } = Astro.props;
const { title, description, date, updated, cover } = entry.data;
const slug = entry.data.slug ?? entry.id;
const imageUrl = cover
  ? new URL(cover.src, SITE.url).href
  : `${SITE.url}${SITE.ogImage}`;
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  image={cover}
  imageAlt={title}
  publishedTime={date}
  modifiedTime={updated}
  jsonLdExtra={[
    {
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: date.toISOString(),
      dateModified: (updated ?? date).toISOString(),
      author: { '@id': `${SITE.url}/#person` },
      mainEntityOfPage: `${SITE.url}/writing/${slug}`,
      image: imageUrl,
    },
  ]}
>
  <article class="prose dark:prose-invert">
    <header>
      <h1>{title}</h1>
      <p>
        <FormattedDate date={date} />
        {updated && (
          <>
            {' · updated '}
            <FormattedDate date={updated} />
          </>
        )}
      </p>
    </header>
    <slot />
  </article>
</BaseLayout>
