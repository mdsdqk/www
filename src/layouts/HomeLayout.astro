---
import VercelAnalytics from '@/islands/VercelAnalytics';
import Seo from '@/components/Seo.astro';
import { SITE, jsonLdGraph, personJsonLd, websiteJsonLd } from '@/lib/site';
import '@/styles/eclipse.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
} = Astro.props;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <Seo
      title={title}
      description={description}
      jsonLd={jsonLdGraph([websiteJsonLd(), personJsonLd()])}
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#060608" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@200;300;400;500;600;800;900&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style is:inline>
      html,body{background:#060608;color:#eae7e1;}
    </style>
  </head>
  <body>
    <a class="skip sr-only" href="#main">Skip to content</a>
    <slot />
    <VercelAnalytics client:load />
  </body>
</html>
